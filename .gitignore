# ============================================================

# PostgreSQL local data
*.sql.gz
*.dump
*.backup

# Local database dumps
database/dumps/
database/backups/

# PostgreSQL temporary files
postmaster.pid
postmaster.opts


# ============================================================
# Redis
# ============================================================

dump.rdb
appendonly.aof


# ============================================================
# MinIO / Object Storage
# ============================================================

.minio/
minio-data/


# ============================================================
# Generated API Code
# ============================================================

# Generated OpenAPI clients
api/generated/

# If generated code is committed to Git,
# remove the rule above.

# Generated SQLC files
database/sqlc/generated/

# If SQLC generated code is committed,
# remove the rule above.


